---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const title = 'Estructuras Jiménez | Equipamiento para el sector porcícola';
const description =
  'Estructuras Jiménez. Fabricación de implementos y equipamiento para el sector porcícola en Tepatitlán de Morelos, Jalisco.';

const products = [
  { number: '01', title: 'Casetas de engorda', category: 'Infraestructura', description: 'Fabricación de casetas destinadas a operaciones de engorda porcícola.' },
  { number: '02', title: 'Bodegas', category: 'Estructuras', description: 'Fabricación de estructuras para bodegas.' },
  { number: '03', title: 'Camas de maternidad', category: 'Maternidad', description: 'Fabricación de camas de maternidad en diferentes modelos.' },
  { number: '04', title: 'Camas de destete', category: 'Destete', description: 'Fabricación de camas para la etapa de destete.' },
  { number: '05', title: 'Jaulas de gestación', category: 'Gestación', description: 'Fabricación de jaulas para gestación porcícola.' },
  { number: '06', title: 'Jaulas porcícolas', category: 'Equipamiento', description: 'Fabricación de jaulas destinadas al sector porcícola.' },
  { number: '07', title: 'Comederos', category: 'Alimentación', description: 'Comederos para las etapas de engorda y destete.' },
  { number: '08', title: 'Tolvas para granos', category: 'Almacenamiento', description: 'Tolvas para almacenamiento de granos.' }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Estructuras Jiménez',
  url: 'https://estructurasjimenez.com',
  telephone: '+52 378 121 4083',
  email: 'gusestructuras23@gmail.com',
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Periférico Salvador Zúñiga 1871',
    addressLocality: 'Tepatitlán de Morelos',
    addressRegion: 'Jalisco',
    addressCountry: 'MX'
  }
};

const year = new Date().getFullYear();
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="#inicio" aria-label="Estructuras Jiménez, inicio">
        <img class="brand-mark brand-mark-header" src="/brand/estructuras-jimenez-auth0.png" alt="Estructuras Jiménez" width="419" height="325" />
      </a>

      <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span></span>
      </button>

      <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
        <a href="#productos">Productos</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#contacto">Contacto</a>
        <a class="nav-quote" href="#cotizar">Cotizar</a>
      </nav>
    </div>
  </header>

  <main>
    <section id="inicio" class="hero">
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="shell hero-layout">
        <div class="hero-copy reveal">
          <div class="kicker-row">
            <span class="eyebrow">Tepatitlán de Morelos · Jalisco</span>
            <span class="hero-index">EJ / 01</span>
          </div>

          <h1>
            Equipamiento
            <span>para el sector porcícola.</span>
          </h1>

          <div class="hero-bottom">
            <p>Fabricación de implementos y equipamiento porcícola desde Tepatitlán de Morelos, Jalisco.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#cotizar">Solicitar cotización <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="#productos">Ver productos <span aria-hidden="true">↓</span></a>
            </div>
          </div>
        </div>

        <div class="hero-brand reveal">
          <div class="hero-brand-frame">
            <span class="frame-label frame-label-top">ESTRUCTURAS JIMÉNEZ</span>
            <img class="brand-mark brand-mark-hero" src="/brand/estructuras-jimenez-auth0.png" alt="Estructuras Jiménez" width="419" height="325" />
            <span class="frame-label frame-label-bottom">TEPATITLÁN · JALISCO</span>
          </div>
        </div>
      </div>

      <div class="shell hero-rail" aria-label="Información principal">
        <div><span>01</span><strong>Sector</strong><small>Porcícola</small></div>
        <div><span>02</span><strong>Fabricación</strong><small>Equipamiento e implementos</small></div>
        <div><span>03</span><strong>Contacto</strong><small>378 121 4083</small></div>
      </div>
    </section>

    <section id="productos" class="section products-section">
      <div class="shell products-layout">
        <aside class="products-intro reveal">
          <span class="section-label">Productos</span>
          <h2>Lo que fabricamos.</h2>
          <p>Una selección de productos para distintas necesidades del sector porcícola.</p>
          <a class="text-link" href="#cotizar">Cotizar un producto <span aria-hidden="true">↗</span></a>
        </aside>

        <div class="product-list">
          {products.map((product) => (
            <article class="product-row reveal">
              <span class="product-number">{product.number}</span>
              <div class="product-main">
                <small>{product.category}</small>
                <h3>{product.title}</h3>
                <p>{product.description}</p>
              </div>
              <a class="product-action" href="#cotizar" data-service={product.title} aria-label={'Cotizar ' + product.title}>
                <span>Cotizar</span>
                <b aria-hidden="true">↗</b>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="technical-section">
      <div class="shell technical-layout">
        <div class="technical-copy reveal">
          <span class="section-label light">Lenguaje técnico</span>
          <h2>Acero, estructura y función.</h2>
          <p>El diseño visual del sitio parte de la misma lógica que el trabajo de Estructuras Jiménez: líneas, módulos, uniones y proporción.</p>
          <div class="technical-tags" aria-hidden="true">
            <span>CASETAS</span><span>CAMAS</span><span>JAULAS</span><span>COMEDEROS</span><span>TOLVAS</span>
          </div>
        </div>

        <div class="technical-drawing reveal" aria-hidden="true">
          <div class="drawing-head"><span>EJ / SYSTEM 01</span><span>TEPATITLÁN, JAL.</span></div>
          <svg viewBox="0 0 760 480">
            <g fill="none" stroke="currentColor" stroke-width="2">
              <path d="M92 356V145L326 48l336 111v197Z"/>
              <path d="M92 145 326 210l336-51M326 48v308M92 356h570"/>
              <path d="M150 162v194M210 179v177M270 196v160M388 193v163M448 184v172M508 174v182M568 165v191M628 158v198"/>
              <path d="M92 296h570M92 326h570" opacity=".55"/>
              <path d="m326 48 58 56 48-29 62 65 58-38 70 58" opacity=".85"/>
            </g>
            <g fill="none" stroke="#F4AFB6" stroke-width="4">
              <path d="M70 145 326 30l360 119"/>
              <path d="M103 377c146-38 302-35 443-8 55 11 105 15 151 7"/>
            </g>
          </svg>
          <div class="drawing-foot"><span>ESTRUCTURA / MODULACIÓN / FABRICACIÓN</span><strong>01—08</strong></div>
        </div>
      </div>
    </section>

    <section id="nosotros" class="section about-section">
      <div class="shell about-layout">
        <div class="about-index reveal">02</div>
        <div class="about-copy reveal">
          <span class="section-label">Nosotros</span>
          <h2>Una empresa de Tepatitlán enfocada en el sector porcícola.</h2>
          <p>Estructuras Jiménez está ubicada en Tepatitlán de Morelos, Jalisco, y se dedica a la fabricación de implementos y equipamiento para el sector porcícola.</p>
        </div>
        <div class="about-mark reveal">
          <img class="brand-mark brand-mark-about" src="/brand/estructuras-jimenez-auth0.png" alt="Estructuras Jiménez" width="419" height="325" />
        </div>
      </div>
    </section>

    <section id="cotizar" class="section quote-section">
      <div class="shell quote-layout">
        <div class="quote-intro reveal" id="contacto">
          <span class="section-label light">Cotización</span>
          <h2>Cuéntanos qué necesitas.</h2>
          <p>Completa los datos disponibles para preparar tu solicitud de cotización.</p>

          <div class="quote-contact">
            <a href="tel:+523781214083"><small>Teléfono</small><strong>378 121 4083</strong><em>↗</em></a>
            <a href="mailto:gusestructuras23@gmail.com"><small>Correo</small><strong>gusestructuras23@gmail.com</strong><em>↗</em></a>
            <a href="https://www.google.com/maps/search/?api=1&query=Periferico+Salvador+Zuniga+1871,+Tepatitlan+de+Morelos,+Jalisco" target="_blank" rel="noopener noreferrer"><small>Ubicación</small><strong>Periférico Salvador Zúñiga 1871</strong><em>↗</em></a>
          </div>
        </div>

        <form class="quote-form reveal" id="quote-form">
          <div class="form-head">
            <span>Solicitud de cotización</span>
            <small>* Información necesaria</small>
          </div>

          <div class="form-grid">
            <label><span>Nombre o empresa *</span><input name="name" autocomplete="name" required placeholder="Nombre o empresa" /></label>
            <label><span>Teléfono *</span><input name="phone" autocomplete="tel" required inputmode="tel" placeholder="378 000 0000" /></label>
            <label>
              <span>Producto *</span>
              <select name="service" required>
                <option value="">Selecciona una opción</option>
                {products.map((product) => <option value={product.title}>{product.title}</option>)}
              </select>
            </label>
            <label><span>Ubicación del proyecto</span><input name="location" placeholder="Municipio / Estado" /></label>
            <label><span>Cantidad o medidas</span><input name="dimensions" placeholder="Dato aproximado" /></label>
            <label><span>Correo</span><input name="email" autocomplete="email" type="email" placeholder="correo@empresa.com" /></label>
            <label class="form-full"><span>Información adicional</span><textarea name="details" rows="5" placeholder="Agrega cualquier dato que quieras incluir en la solicitud."></textarea></label>
          </div>

          <label class="consent">
            <input type="checkbox" required />
            <span>Acepto que Estructuras Jiménez utilice estos datos para atender mi solicitud.</span>
          </label>

          <div class="form-actions">
            <button class="button button-light-pink" type="submit">Preparar solicitud <span aria-hidden="true">↗</span></button>
            <button class="button button-copy" type="button" id="copy-quote">Copiar resumen</button>
            <p id="quote-status" aria-live="polite">Puedes enviarla por correo o copiar el resumen.</p>
          </div>
        </form>
      </div>
    </section>

    <section class="privacy-section">
      <div class="shell privacy-row">
        <a href="/aviso-de-privacidad">Aviso de privacidad →</a>
        <a href="#inicio">Volver al inicio ↑</a>
      </div>
    </section>
  </main>

  <div class="mobile-quick-actions" aria-label="Acciones rápidas">
    <a href="tel:+523781214083">Llamar</a>
    <a href="#cotizar">Cotizar</a>
  </div>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-brand">
        <img class="brand-mark brand-mark-footer" src="/brand/estructuras-jimenez-auth0.png" alt="Estructuras Jiménez" width="419" height="325" />
        <p>Implementos y equipamiento para el sector porcícola.</p>
      </div>
      <div><span>Navegación</span><a href="#productos">Productos</a><a href="#nosotros">Nosotros</a><a href="#cotizar">Cotizar</a></div>
      <div><span>Contacto</span><a href="tel:+523781214083">378 121 4083</a><a href="mailto:gusestructuras23@gmail.com">Correo</a><a href="https://www.google.com/maps/search/?api=1&query=Periferico+Salvador+Zuniga+1871,+Tepatitlan+de+Morelos,+Jalisco" target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a></div>
      <div class="footer-signature"><strong>© {year}</strong><span>Tepatitlán de Morelos, Jalisco</span></div>
    </div>
  </footer>

  <script is:inline>
    const menuButton = document.querySelector('.menu-toggle');
    const nav = document.querySelector('.main-nav');
    const header = document.querySelector('.site-header');

    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      nav?.classList.toggle('open');
    });

    document.querySelectorAll('.main-nav a').forEach((link) => link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      nav?.classList.remove('open');
    }));

    document.querySelectorAll('[data-service]').forEach((link) => {
      link.addEventListener('click', () => {
        const select = document.querySelector('select[name="service"]');
        if (select instanceof HTMLSelectElement) select.value = link.getAttribute('data-service') || '';
      });
    });

    const buildQuoteBody = (data) => [
      'SOLICITUD DE COTIZACIÓN - ESTRUCTURAS JIMÉNEZ',
      '',
      'Nombre / empresa: ' + (data.get('name') || ''),
      'Teléfono: ' + (data.get('phone') || ''),
      'Correo: ' + (data.get('email') || 'No indicado'),
      'Producto: ' + (data.get('service') || ''),
      'Ubicación: ' + (data.get('location') || 'No indicada'),
      'Cantidad o medidas: ' + (data.get('dimensions') || 'No indicadas'),
      '',
      'Información adicional:',
      String(data.get('details') || 'Sin información adicional')
    ].join('\n');

    const copyButton = document.querySelector('#copy-quote');
    copyButton?.addEventListener('click', async () => {
      const quoteForm = document.querySelector('#quote-form');
      if (!(quoteForm instanceof HTMLFormElement)) return;
      const status = document.querySelector('#quote-status');
      try {
        await navigator.clipboard.writeText(buildQuoteBody(new FormData(quoteForm)));
        if (status) status.textContent = 'Resumen copiado.';
      } catch {
        if (status) status.textContent = 'No se pudo copiar automáticamente.';
      }
    });

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach((item) => revealObserver.observe(item));

    const form = document.querySelector('#quote-form');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const data = new FormData(form);
      const subject = 'Solicitud de cotización - ' + (data.get('service') || 'Estructuras Jiménez');
      window.location.href = 'mailto:gusestructuras23@gmail.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(buildQuoteBody(data));
      const status = document.querySelector('#quote-status');
      if (status) status.textContent = 'Solicitud preparada.';
    });
  </script>
</BaseLayout>
