---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructureIllustration from '../components/StructureIllustration.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

const title = 'Estructuras Jiménez | Estructuras metálicas y equipamiento';
const description = 'Fabricación de estructuras metálicas, bodegas, casetas, tolvas y equipamiento porcino en Tepatitlán de Morelos, Jalisco. Cuéntanos sobre tu proyecto.';
const phone = '+523781214083';
const email = 'gusestructuras23@gmail.com';
const maps = 'https://www.google.com/maps/search/?api=1&query=Periferico+Salvador+Zuniga+1871,+Tepatitlan+de+Morelos,+Jalisco';
const groups = [
  { number: '01', icon: 'structure', title: 'Estructuras', description: 'Espacios para trabajar, almacenar y producir.', products: ['Bodegas', 'Casetas de engorda'] },
  { number: '02', icon: 'equipment', title: 'Equipamiento porcino', description: 'Soluciones para las distintas etapas de tu granja.', products: ['Camas de maternidad', 'Camas de destete', 'Jaulas de gestación', 'Jaulas porcícolas'] },
  { number: '03', icon: 'storage', title: 'Alimentación y almacenamiento', description: 'Equipamiento para el manejo de alimento y granos.', products: ['Comederos', 'Tolvas para granos'] }
];
const products = groups.flatMap((group) => group.products);
const structuredData = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', name: 'Estructuras Jiménez',
  url: 'https://estructurasjimenez.com', telephone: phone, email, description,
  address: { '@type': 'PostalAddress', streetAddress: 'Periférico Salvador Zúñiga 1871', addressLocality: 'Tepatitlán de Morelos', addressRegion: 'Jalisco', addressCountry: 'MX' }
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="#inicio" aria-label="Estructuras Jiménez, inicio">
        <img class="brand-mark-header" src="/brand/estructuras-jimenez-auth0.png" alt="Estructuras Jiménez" width="419" height="325" fetchpriority="high" />
      </a>
      <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
        <a href="#productos">Productos</a><a href="#nosotros">Nosotros</a><a href="#contacto">Contacto</a>
      </nav>
      <a class="button button-primary header-quote" href="#cotizar">Cotizar proyecto <Icon name="arrow" /></a>
      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-nav"><span></span><span></span></button>
    </div>
  </header>

  <main id="contenido">
    <section id="inicio" class="hero" aria-labelledby="hero-title">
      <div class="shell hero-layout">
        <div class="hero-copy">
          <span class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Tepatitlán de Morelos, Jalisco</span>
          <h1 id="hero-title">Estructuras metálicas <span>y equipamiento.</span></h1>
          <p class="hero-description">Damos forma a tu proyecto. Fabricamos bodegas, casetas, tolvas y equipamiento especializado, con experiencia en el sector porcino.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#cotizar">Cuéntanos tu proyecto <Icon name="arrow" /></a>
            <a class="button button-outline" href="#productos">Explorar productos <Icon name="down" /></a>
          </div>
          <a class="hero-phone" href={'tel:' + phone}><Icon name="phone" /><span>¿Prefieres llamarnos? <strong>378 121 4083</strong></span></a>
        </div>
        <figure class="hero-visual">
          <div class="visual-heading"><span>ESTRUCTURAS JIMÉNEZ</span><span class="visual-cross" aria-hidden="true">+</span></div>
          <StructureIllustration />
          <figcaption><div><span class="visual-caption-label">De la estructura al equipamiento</span><strong>Tu proyecto toma forma aquí.</strong></div><a href="#productos" aria-label="Explorar los productos"><Icon name="arrow" /></a></figcaption>
          <span class="illustration-note">Ilustración de estructura metálica</span>
        </figure>
      </div>
    </section>

    <section id="productos" class="section products-section" aria-labelledby="products-title">
      <div class="shell">
        <div class="section-heading"><div><span class="section-label">Lo que hacemos</span><h2 id="products-title">Una solución para cada necesidad.</h2></div><p>Estructuras y equipamiento en un solo lugar. Encuentra lo que necesitas y solicita tu cotización.</p></div>
        <div class="product-grid">
          {groups.map((group) => (
            <article class="product-card">
              <div class="product-card-top"><span class="product-icon"><Icon name={group.icon} /></span><span class="product-number">{group.number}</span></div>
              <h3>{group.title}</h3><p>{group.description}</p>
              <ul class="product-options">{group.products.map((product) => <li><a href="#cotizar" data-service={product}><span>{product}</span><Icon name="arrow" /><span class="sr-only">: cotizar</span></a></li>)}</ul>
            </article>
          ))}
        </div>
        <p class="products-note">¿Tienes un proyecto diferente? <a href="#cotizar" data-service="Otro proyecto">Cuéntanos qué necesitas <span aria-hidden="true">↗</span></a></p>
      </div>
    </section>

    <section id="nosotros" class="about-section" aria-labelledby="about-title">
      <div class="shell about-layout">
        <div><span class="section-label light">Nosotros</span><h2 id="about-title">De Tepatitlán.<br />Para tu próximo proyecto.</h2></div>
        <div class="about-copy"><p>Somos Estructuras Jiménez, una empresa dedicada a la fabricación de estructuras metálicas y equipamiento en Tepatitlán de Morelos, Jalisco.</p><p>El sector porcino es una parte importante de nuestro trabajo. También fabricamos bodegas y tolvas para granos, y atendemos consultas para otros proyectos.</p><a class="text-link light" href="#contacto">Hablemos de lo que necesitas <Icon name="arrow" /></a></div>
      </div>
    </section>

    <section id="cotizar" class="section quote-section" aria-labelledby="quote-title">
      <div class="shell quote-layout">
        <div class="quote-intro" id="contacto">
          <span class="section-label">Hablemos</span><h2 id="quote-title">El primer paso es <span>tu idea.</span></h2>
          <p>Cuéntanos qué quieres fabricar. Puedes preparar tu solicitud o contactarnos directamente.</p>
          <div class="contact-list">
            <a href={'tel:' + phone}><span class="contact-icon"><Icon name="phone" /></span><span><small>Llámanos</small><strong>378 121 4083</strong></span><Icon name="arrow" /></a>
            <a href={'mailto:' + email}><span class="contact-icon"><Icon name="mail" /></span><span><small>Escríbenos</small><strong>{email}</strong></span><Icon name="arrow" /></a>
          </div>
          <a class="location-card" href={maps} target="_blank" rel="noopener noreferrer"><span class="contact-icon"><Icon name="pin" /></span><span><strong>Visítanos en Tepatitlán</strong><small>Periférico Salvador Zúñiga 1871<br />Tepatitlán de Morelos, Jalisco</small><b>Cómo llegar <span aria-hidden="true">↗</span></b></span></a>
        </div>
        <form class="quote-form" id="quote-form" action={'mailto:' + email} method="post" enctype="text/plain">
          <div class="form-head"><h3>Solicitar cotización</h3><p>Los campos con * son obligatorios.</p></div>
          <div class="form-grid">
            <label><span>Nombre o empresa *</span><input name="name" autocomplete="name" required maxlength="120" placeholder="¿Cómo te llamas?" /></label>
            <label><span>Teléfono *</span><input type="tel" name="phone" autocomplete="tel" required minlength="7" maxlength="30" placeholder="Tu número de contacto" /></label>
            <label class="form-full"><span>¿Qué necesitas? *</span><select name="service" required><option value="">Selecciona un producto o proyecto</option>{products.map((product) => <option value={product}>{product}</option>)}<option value="Otro proyecto">Otro proyecto</option></select></label>
            <label><span>Ubicación del proyecto <small>(opcional)</small></span><input name="location" autocomplete="address-level2" maxlength="160" placeholder="Municipio y estado" /></label>
            <label><span>Correo <small>(opcional)</small></span><input type="email" name="email" autocomplete="email" maxlength="160" placeholder="correo@ejemplo.com" /></label>
            <label class="form-full"><span>Cuéntanos un poco más <small>(opcional)</small></span><textarea name="details" rows="3" maxlength="2500" placeholder="Medidas aproximadas, cantidades o lo que tienes en mente."></textarea></label>
          </div>
          <label class="consent"><input type="checkbox" name="consent" required /><span>Acepto el uso de mis datos para atender esta solicitud, de acuerdo con el <a href="/aviso-de-privacidad" target="_blank" rel="noopener">aviso de privacidad</a>.</span></label>
          <button class="button button-primary form-submit" type="submit">Continuar por correo <Icon name="arrow" /></button>
          <div class="form-alternative"><span>¿Prefieres otro medio?</span><button type="button" id="copy-quote">Copiar solicitud <Icon name="copy" /></button></div>
          <p class="quote-status" id="quote-status" role="status">Se abrirá tu aplicación de correo para que revises y envíes la solicitud.</p>
          <label class="quote-summary" id="quote-summary-wrap" hidden><span>Copia este texto y compártelo por el medio que prefieras.</span><textarea id="quote-summary" rows="9" readonly></textarea></label>
        </form>
      </div>
    </section>
  </main>
  <footer class="site-footer"><div class="shell footer-inner"><div><strong>Estructuras Jiménez</strong><span>Estructuras metálicas y equipamiento · Tepatitlán, Jalisco</span></div><div class="footer-links"><a href="/aviso-de-privacidad">Aviso de privacidad</a><a href="#inicio">Volver arriba <span aria-hidden="true">↑</span></a><span>© {new Date().getFullYear()}</span></div></div></footer>
  <div class="mobile-quick-actions" aria-label="Acciones rápidas"><a href={'tel:' + phone}><Icon name="phone" /> Llamar</a><a href="#cotizar">Cotizar proyecto <Icon name="arrow" /></a></div>
  <script src="../scripts/home.ts"></script>
</BaseLayout>
