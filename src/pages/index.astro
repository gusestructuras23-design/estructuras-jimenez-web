---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const title = 'Estructuras Jiménez | Implementos porcícolas';
const description =
  'Estructuras Jiménez. Fabricación de implementos y equipamiento para el sector porcícola en Tepatitlán de Morelos, Jalisco, México.';

const products = [
  {
    number: '01',
    title: 'Casetas de engorda',
    description: 'Fabricación de casetas destinadas a operaciones de engorda porcícola.'
  },
  {
    number: '02',
    title: 'Bodegas',
    description: 'Fabricación de estructuras para bodegas.'
  },
  {
    number: '03',
    title: 'Camas de maternidad',
    description: 'Fabricación de camas de maternidad en diferentes modelos.'
  },
  {
    number: '04',
    title: 'Camas de destete',
    description: 'Fabricación de camas para la etapa de destete.'
  },
  {
    number: '05',
    title: 'Jaulas de gestación',
    description: 'Fabricación de jaulas para gestación porcícola.'
  },
  {
    number: '06',
    title: 'Jaulas porcícolas',
    description: 'Fabricación de jaulas destinadas al sector porcícola.'
  },
  {
    number: '07',
    title: 'Comederos',
    description: 'Comederos para las etapas de engorda y destete.'
  },
  {
    number: '08',
    title: 'Tolvas para granos',
    description: 'Tolvas para almacenamiento de granos.'
  }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Estructuras Jiménez',
  url: 'https://estructurasjimenez.com',
  telephone: '+52 378 121 4083',
  description:
    'Fabricación de implementos y equipamiento para el sector porcícola.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tepatitlán de Morelos',
    addressRegion: 'Jalisco',
    addressCountry: 'MX'
  }
};

const year = new Date().getFullYear();
---

<BaseLayout title={title} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  ></script>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#inicio" aria-label="Estructuras Jiménez, inicio">
        <span class="brand-mark">EJ</span>
        <span class="brand-name">
          <strong>Estructuras</strong>
          <span>Jiménez</span>
        </span>
      </a>

      <button
        class="menu-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
        <a href="#nosotros">Nosotros</a>
        <a href="#servicios">Productos</a>
        <a href="#contacto">Contacto</a>
        <a href="#privacidad">Privacidad</a>
      </nav>
    </div>
  </header>

  <main>
    <section id="inicio" class="hero">
      <div class="hero-grid" aria-hidden="true"></div>

      <div class="container hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">Tepatitlán de Morelos · Jalisco · México</span>

          <h1>
            Fabricación de
            <span>implementos porcícolas</span>
          </h1>

          <p>
            Estructuras Jiménez fabrica equipamiento y estructuras para el
            sector porcícola.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="tel:+523781214083">
              Llamar a oficina
            </a>

            <a class="button button-secondary" href="#servicios">
              Ver productos
            </a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="structure structure-a"></div>
          <div class="structure structure-b"></div>
          <div class="structure structure-c"></div>

          <div class="hero-card">
            <span>Sector</span>
            <strong>Porcícola</strong>
            <small>Estructuras Jiménez</small>
          </div>
        </div>
      </div>
    </section>

    <section id="nosotros" class="section about">
      <div class="container two-column">
        <div>
          <span class="section-label">Nosotros</span>
          <h2>Soluciones para el sector porcícola</h2>
        </div>

        <div class="about-copy">
          <p>
            Estructuras Jiménez es una empresa ubicada en Tepatitlán de Morelos,
            Jalisco, dedicada a la fabricación de implementos y equipamiento
            para el sector porcícola.
          </p>

          <p>
            Fabricamos distintos tipos de estructuras, jaulas, camas,
            comederos y sistemas de almacenamiento para granos.
          </p>
        </div>
      </div>
    </section>

    <section id="servicios" class="section products-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-label">Productos</span>
            <h2>Equipamiento porcícola</h2>
          </div>

          <p>
            Fabricación de implementos para diferentes necesidades dentro de
            una operación porcícola.
          </p>
        </div>

        <div class="products-grid">
          {
            products.map((product) => (
              <article class="product-card">
                <span class="product-number">{product.number}</span>
                <h3>{product.title}</h3>
                <p>{product.description}</p>
                <div class="card-line"></div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contacto" class="section contact-section">
      <div class="container contact-grid">
        <div>
          <span class="section-label light">Contacto</span>

          <h2>Hablemos de lo que necesitas fabricar.</h2>

          <p>
            Comunícate directamente con nuestra oficina para solicitar
            información sobre nuestros productos.
          </p>
        </div>

        <div class="contact-card">
          <div class="contact-item">
            <span>Empresa</span>
            <strong>Estructuras Jiménez</strong>
          </div>

          <div class="contact-item">
            <span>Ubicación</span>
            <strong>Tepatitlán de Morelos, Jalisco, México</strong>
          </div>

          <div class="contact-item">
            <span>Teléfono de oficina</span>
            <a href="tel:+523781214083">378 121 4083</a>
          </div>

          <a class="button button-light" href="tel:+523781214083">
            Llamar ahora
          </a>
        </div>
      </div>
    </section>

    <section id="privacidad" class="section privacy-section">
      <div class="container privacy-content">
        <div>
          <span class="section-label">Privacidad</span>
          <h2>Aviso de privacidad</h2>
        </div>

        <div class="privacy-copy">
          <p>
            Estructuras Jiménez es responsable del tratamiento de los datos
            personales que, en su caso, sean proporcionados de manera
            voluntaria al ponerse en contacto con la empresa.
          </p>

          <p>
            Los datos proporcionados serán utilizados para atender solicitudes
            de información, contacto y seguimiento relacionado con nuestros
            productos y servicios.
          </p>

          <p>
            Esta versión del sitio no cuenta con formularios de captura de
            datos personales. El alojamiento puede procesar datos técnicos
            necesarios para la operación y seguridad del sitio.
          </p>

          <p>
            Para cualquier consulta relacionada con privacidad puede
            comunicarse al teléfono de oficina
            <a href="tel:+523781214083">378 121 4083</a>.
          </p>

          <small>Última actualización: septiembre de 2026.</small>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="brand footer-brand">
        <span class="brand-mark">EJ</span>
        <span class="brand-name">
          <strong>Estructuras</strong>
          <span>Jiménez</span>
        </span>
      </div>

      <div class="footer-copy">
        <span>© {year} Estructuras Jiménez</span>
        <span>Tepatitlán de Morelos, Jalisco, México</span>
      </div>
    </div>
  </footer>

  <script is:inline>
    const button = document.querySelector('.menu-toggle');
    const nav = document.querySelector('.main-nav');

    button?.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      nav?.classList.toggle('open');
    });

    document.querySelectorAll('.main-nav a').forEach((link) => {
      link.addEventListener('click', () => {
        button?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('open');
      });
    });
  </script>
</BaseLayout>
